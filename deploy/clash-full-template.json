{
  "port": 7890,
  "socks-port": 7891,
  "mixed-port": 7892,
  "allow-lan": true,
  "bind-address": "*",
  "mode": "rule",
  "log-level": "info",
  "external-controller": "127.0.0.1:9090",
  "proxies": "<PROXY_REPLACE>",
  "proxy-groups": [
    {
      "name": "Proxy",
      "type": "select",
      "proxies": "<NODE_REPLACE>"
    },
    {
      "name": "Auto",
      "type": "url-test",
      "url": "http://www.gstatic.com/generate_204",
      "interval": 300,
      "tolerance": 50,
      "proxies": "<NODE_REPLACE>"
    },
    {
      "name": "Domestic",
      "type": "select",
      "proxies": ["DIRECT", "Proxy"]
    },
    {
      "name": "Global",
      "type": "select",
      "proxies": ["Proxy", "DIRECT"]
    }
  ],
  "rules": [
    "DOMAIN-SUFFIX,local,DIRECT",
    "IP-CIDR,127.0.0.0/8,DIRECT",
    "IP-CIDR,172.16.0.0/12,DIRECT",
    "IP-CIDR,192.168.0.0/16,DIRECT",
    "IP-CIDR,10.0.0.0/8,DIRECT",
    "IP-CIDR,100.64.0.0/10,DIRECT",
    "IP-CIDR,224.0.0.0/4,DIRECT",
    "IP-CIDR,fe80::/10,DIRECT",
    "DOMAIN-SUFFIX,cn,Domestic",
    "DOMAIN-KEYWORD,google,Global",
    "DOMAIN-KEYWORD,youtube,Global",
    "DOMAIN-KEYWORD,github,Global",
    "DOMAIN-KEYWORD,twitter,Global",
    "DOMAIN-KEYWORD,telegram,Global",
    "MATCH,Global"
  ],
  "dns": {
    "enable": true,
    "listen": "0.0.0.0:1053",
    "default-nameserver": ["223.5.5.5", "119.29.29.29"],
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "nameserver": ["https://doh.pub/dns-query", "https://dns.alidns.com/dns-query"],
    "fallback": ["https://1.1.1.1/dns-query", "https://8.8.8.8/dns-query"],
    "fallback-filter": {
      "geoip": true,
      "geoip-code": "CN",
      "ipcidr": ["240.0.0.0/4"]
    }
  }
}
