FROM rust:1.86 AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p pp-hub

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/proxy-panel-hub /usr/local/bin/proxy-panel-hub
EXPOSE 8080
ENTRYPOINT ["proxy-panel-hub"]
