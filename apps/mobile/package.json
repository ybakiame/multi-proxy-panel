{
  "name": "pp-client-mobile-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "lint": "oxlint src/ --deny-warnings",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "verify": "bun run build && bun run lint && bun run format:check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@heroui/react": "3.2.2",
    "@heroui/styles": "^3.2.2",
    "@pp/client-core": "workspace:*",
    "@tanstack/react-query": "^5.102.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
