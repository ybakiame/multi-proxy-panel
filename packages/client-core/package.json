{
  "name": "@pp/client-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "客户端（Desktop/Mobile）共享前端库：api 封装 + hooks + atoms + 纯工具（源码直出，无构建步骤）",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint src/ --deny-warnings",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@heroui/react": "3.2.2",
    "@tanstack/react-query": "^5.102.7",
    "@tauri-apps/api": "^2",
    "jotai": "^2.20.1",
    "react": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  }
}
