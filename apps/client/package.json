{
  "name": "pp-client-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "dev:android": "vite --mode android",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "lint": "oxlint src/ --deny-warnings",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "verify": "bun run build && bun run build:android && bun run lint && bun run format:check",
    "tauri": "tauri",
    "fetch-seed": "bun scripts/fetch-seed-core.ts",
    "android:dev": "tauri android dev --target aarch64",
    "android:build": "CARGO_PROFILE_RELEASE_OPT_LEVEL=z tauri android build --target aarch64"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.3",
    "@heroicons/react": "^2.2.0",
    "@pp/client-core": "workspace:*",
    "@pp/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.7",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@uiw/react-codemirror": "^4.25.11",
    "clsx": "^2.1.1",
    "jotai": "^2.20.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.5.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fflate": "^0.8.3",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
