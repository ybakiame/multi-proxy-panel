# Replace panel.example.com, grpc.example.com and the bcrypt hash before use.
# Keep the gRPC subdomain DNS-only (grey cloud); the panel may use Cloudflare.
# Generate the hash interactively with `caddy hash-password`.
grpc.example.com {
    @grpc path /proxypanel.HubAgent/*
    handle @grpc {
        reverse_proxy h2c://127.0.0.1:50052
    }
}

panel.example.com {
    encode zstd gzip

    @grpc path /proxypanel.HubAgent/*
    handle @grpc {
        reverse_proxy h2c://127.0.0.1:50052
    }

    # Subscription clients and installers must not require admin credentials.
    @public path /sub/* /install.sh /install-hub.sh /health /ready
    handle @public {
        reverse_proxy 127.0.0.1:8081
    }

    # The React UI, management API and metrics require a second credential.
    handle {
        basic_auth {
            admin REPLACE_WITH_BCRYPT_HASH
        }
        reverse_proxy 127.0.0.1:8081
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
