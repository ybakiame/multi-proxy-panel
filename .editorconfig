# EditorConfig 核心配置
root = true

# ==================== 所有文件默认设置 ====================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# ==================== 代码缩进设置 ====================
[*.{js,ts,jsx,tsx,vue,html,json,jsonc,yml,yaml,md}]
indent_style = space
indent_size = 2

# CSS / SCSS / Less
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = 0

# ==================== 特定文件覆盖 ====================
# TypeScript + JavaScript
[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

# Vue 单文件组件
[*.vue]
indent_style = space
indent_size = 2

# Prettier / 格式化工具统一
[{package.json,.prettierrc,.eslintrc,.eslintrc.json}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

# ==================== 忽略文件 ====================
[*.min.{js,css},*.bundle.{js}]
indent_style = space
indent_size = 2
