# ProxyPanel Environment Configuration
# Copy this file to .env and customize for your deployment.

# PostgreSQL connection
POSTGRES_PASSWORD=changeme

# Hub database URL (overrides hub.toml)
PROXYPANEL_DATABASE_URL=postgres://proxypanel:changeme@localhost:5432/proxypanel

# Bootstrap API key (first-time setup; generated automatically if not set)
PROXYPANEL_BOOTSTRAP_API_KEY=

# JWT secret for admin user authentication (change this!)
PROXYPANEL_JWT_SECRET=change-me-to-a-long-random-string

# HTTP API listen address
PROXYPANEL_HUB_LISTEN=0.0.0.0:8081

# gRPC listen address
PROXYPANEL_GRPC_LISTEN=0.0.0.0:50052

# HTTP TLS (optional — comment out for plain HTTP)
# PROXYPANEL_HTTP_TLS_CERT=/path/to/cert.pem
# PROXYPANEL_HTTP_TLS_KEY=/path/to/key.pem

# gRPC TLS (optional — comment out for plain gRPC)
# PROXYPANEL_GRPC_TLS_CERT=/path/to/cert.pem
# PROXYPANEL_GRPC_TLS_KEY=/path/to/key.pem

# Agent token (set when running agent)
PROXYPANEL_AGENT_TOKEN=

# Agent auto-register (development only — do NOT enable in production)
# PROXYPANEL_AUTO_REGISTER_AGENTS=true
